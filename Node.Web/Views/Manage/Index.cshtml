@* Gebruikersparametrisatie: eigen profielvelden aanpassen. *@
@model Node.Web.Models.Account.ManageProfileViewModel
@{
    ViewData["Title"] = Localizer["ManageProfile_Title"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted">
            @Localizer["ManageProfile_Uitleg"]
        </p>

        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="ProfilePicture" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.HuidigeProfielFotoUrl))
                {
                    <img src="@Model.HuidigeProfielFotoUrl" alt="@Localizer["ManageProfile_HuidigeFotoAlt"]" class="d-block mb-2 rounded" style="width: 120px; height: 120px; object-fit: cover;" />
                }
                <input asp-for="ProfilePicture" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BirthDate" class="form-label"></label>
                    <input asp-for="BirthDate" class="form-control" type="date" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="BirthTime" class="form-label"></label>
                    <input asp-for="BirthTime" class="form-control" type="time" />
                    <span asp-validation-for="BirthTime" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="BirthPlace" class="form-label"></label>
                <input asp-for="BirthPlace" class="form-control" />
                <span asp-validation-for="BirthPlace" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender" class="form-select">
                    <option value=""></option>
                    <option value="Male">@Localizer["Gender_Male"]</option>
                    <option value="Female">@Localizer["Gender_Female"]</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="LooksForMen" class="form-check-input" />
                    <label asp-for="LooksForMen" class="form-check-label"></label>
                </div>
                <div class="form-check">
                    <input asp-for="LooksForWomen" class="form-check-input" />
                    <label asp-for="LooksForWomen" class="form-check-label"></label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">@Localizer["ManageProfile_Opslaan"]</button>
            <a asp-action="ChangePassword" class="btn btn-outline-secondary">@Localizer["ChangePassword_Title"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
