@* Matchoverzicht naar het voorbeeld van Bumble: per match de naam, de score,
   het laatste bericht en het aantal ongelezen berichten. *@
@model IReadOnlyList<Node.Web.Models.Matches.MatchOverviewViewModel>
@{
    ViewData["Title"] = "Matches";
}

<div class="mx-auto" style="max-width: 44rem;">
    <p class="kicker mb-1">Jouw matches</p>
    <h1 class="mb-4">Matches</h1>

    @if (Model.Count == 0)
    {
        <div class="card text-center p-5">
            <p class="kicker mb-3">Nog even geduld</p>
            <h2>Nog geen matches</h2>
            <p class="text-muted mb-4">Begin met ontdekken — bij een wederzijdse like verschijnt de match hier.</p>
            <div>
                <a class="btn btn-primary" asp-controller="Swipe" asp-action="Index">Ontdek profielen</a>
            </div>
        </div>
    }
    else
    {
        <div class="match-lijst">
            @foreach (var match in Model)
            {
                <a class="match-rij d-flex align-items-center gap-3 text-decoration-none"
                   asp-action="Chat" asp-route-id="@match.MatchId">
                    @if (!string.IsNullOrEmpty(match.OtherProfilePictureUrl))
                    {
                        <img src="@match.OtherProfilePictureUrl" alt="Profielfoto van @match.OtherDisplayName" class="avatar-cirkel" />
                    }
                    else
                    {
                        <span class="avatar-cirkel">@match.OtherDisplayName[0]</span>
                    }
                    <span class="flex-grow-1 min-w-0">
                        <span class="d-block match-naam">@match.OtherDisplayName</span>
                        <span class="d-block text-muted small text-truncate">
                            @(match.LastMessagePreview ?? "Nog geen berichten — zeg hallo.")
                        </span>
                    </span>
                    @if (match.UnreadCount > 0)
                    {
                        <span class="ongelezen-stip" title="@match.UnreadCount ongelezen">@match.UnreadCount</span>
                    }
                    <span class="kicker">@match.CompatibilityScore</span>
                </a>
            }
        </div>
    }
</div>
