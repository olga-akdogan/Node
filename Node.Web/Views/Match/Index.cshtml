@* Match overview in the style of Bumble: per match the name, the score,
   the last message and the number of unread messages. *@
@model IReadOnlyList<Node.Web.Models.Matches.MatchOverviewViewModel>
@{
    ViewData["Title"] = Localizer["Match_Title"];
}

<div class="mx-auto" style="max-width: 44rem;">
    <p class="kicker mb-1">@Localizer["Match_Kicker"]</p>
    <h1 class="mb-4">@Localizer["Match_Title"]</h1>

    @if (Model.Count == 0)
    {
        <div class="card text-center p-5">
            <p class="kicker mb-3">@Localizer["NoChartYet_Kicker"]</p>
            <h2>@Localizer["Match_NoMatches_Title"]</h2>
            <p class="text-muted mb-4">@Localizer["Match_NoMatches_Text"]</p>
            <div>
                <a class="btn btn-primary" asp-controller="Swipe" asp-action="Index">@Localizer["Match_DiscoverProfiles"]</a>
            </div>
        </div>
    }
    else
    {
        <form method="get" class="d-flex justify-content-end mb-3">
            <label class="visually-hidden" for="sort">@Localizer["Match_Sort"]</label>
            <select id="sort" name="sort" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="recent" selected="@(((string?)ViewData["Sort"] == "recent") ? "selected" : null)">@Localizer["Match_SortRecent"]</option>
                <option value="score" selected="@(((string?)ViewData["Sort"] == "score") ? "selected" : null)">@Localizer["Match_SortScore"]</option>
            </select>
        </form>
        <div class="match-list">
            @foreach (var match in Model)
            {
                <a class="match-row d-flex align-items-center gap-3 text-decoration-none"
                   asp-action="Chat" asp-route-id="@match.MatchId">
                    @if (!string.IsNullOrEmpty(match.OtherProfilePictureUrl))
                    {
                        <img src="@match.OtherProfilePictureUrl" alt="@match.OtherDisplayName" class="avatar-circle" />
                    }
                    else
                    {
                        <span class="avatar-circle">@match.OtherDisplayName[0]</span>
                    }
                    <span class="flex-grow-1 min-w-0">
                        <span class="d-block match-name">@match.OtherDisplayName</span>
                        <span class="d-block text-muted small text-truncate">
                            @(match.LastMessagePreview ?? Localizer["Match_NoMessages"])
                        </span>
                    </span>
                    @if (match.UnreadCount > 0)
                    {
                        <span class="unread-dot" title="@string.Format(Localizer["Match_UnreadTitle"], match.UnreadCount)">@match.UnreadCount</span>
                    }
                    <span class="kicker">@match.CompatibilityScore</span>
                </a>
            }
        </div>
    }
</div>
