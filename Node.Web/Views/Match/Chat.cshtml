@* Chatscherm met tekstballonnen (eigen berichten rechts, zoals bij
   Tinder/Bumble). De berichten komen niet van onze server: de browser
   verbindt hier rechtstreeks met GetStream Chat via stream-chat-js en houdt
   het gesprek live bij (nieuwe berichten verschijnen zonder herladen). *@
@model Node.Web.Models.Matches.ChatViewModel
@{
    ViewData["Title"] = Model.OtherDisplayName;
}

<div class="mx-auto" style="max-width: 44rem;">
    <div class="d-flex align-items-baseline justify-content-between border-bottom pb-3 mb-3">
        <div>
            <a class="kicker text-decoration-none" asp-action="Index">&larr; Matches</a>
            <h1 class="mb-0 mt-1">@Model.OtherDisplayName</h1>
        </div>
        <div class="text-end">
            <span class="score-cijfer">@Model.CompatibilityScore</span>
            <p class="kicker mb-0">Match-score</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.CompatibilityExplanation))
    {
        <p class="text-muted small mb-4">@Model.CompatibilityExplanation</p>
    }

    <div id="chat-app"
         data-api-key="@Model.StreamApiKey"
         data-user-token="@Model.StreamUserToken"
         data-current-user-id="@Model.CurrentUserId"
         data-other-user-id="@Model.OtherUserId">
        <div id="berichten" class="chat-venster mb-3">
            <p class="text-muted small text-center">Gesprek laden&hellip;</p>
        </div>

        <form id="chat-formulier" class="d-flex gap-2">
            <input type="text" id="chat-invoer" class="form-control"
                   placeholder="Schrijf een bericht" maxlength="1000" autocomplete="off" />
            <button type="submit" class="btn btn-primary">Verstuur</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/stream-chat@8.57.4/dist/browser.full-bundle.min.js"></script>
    <script>
        // Chat-logica met GetStream: verbinden, bestaande berichten tonen en
        // live meeluisteren naar nieuwe berichten van de andere gebruiker.
        (async function () {
            const app = document.getElementById('chat-app');
            const venster = document.getElementById('berichten');
            const formulier = document.getElementById('chat-formulier');
            const invoer = document.getElementById('chat-invoer');
            const eigenGebruikerId = app.dataset.currentUserId;

            const client = StreamChat.getInstance(app.dataset.apiKey);
            await client.connectUser({ id: eigenGebruikerId }, app.dataset.userToken);

            // Kanaal zonder expliciete id: GetStream leidt de id af uit de
            // ledenlijst, zodat dezelfde twee gebruikers altijd hetzelfde
            // gesprek terugvinden.
            const channel = client.channel('messaging', {
                members: [eigenGebruikerId, app.dataset.otherUserId],
            });
            await channel.watch();
            await channel.markRead();

            function toonBericht(bericht) {
                const isMijn = bericht.user.id === eigenGebruikerId;

                const rij = document.createElement('div');
                rij.className = 'd-flex ' + (isMijn ? 'justify-content-end' : 'justify-content-start');

                const ballon = document.createElement('div');
                ballon.className = 'ballon ' + (isMijn ? 'ballon-mijn' : 'ballon-ander');

                const tekst = document.createElement('span');
                tekst.textContent = bericht.text;

                const tijd = document.createElement('span');
                tijd.className = 'ballon-tijd';
                tijd.textContent = new Date(bericht.created_at).toLocaleTimeString('nl-BE', {
                    hour: '2-digit', minute: '2-digit',
                });

                ballon.appendChild(tekst);
                ballon.appendChild(tijd);
                rij.appendChild(ballon);
                venster.appendChild(rij);
                venster.scrollTop = venster.scrollHeight;
            }

            venster.innerHTML = '';
            channel.state.messages.forEach(toonBericht);
            venster.scrollTop = venster.scrollHeight;

            channel.on('message.new', function (event) {
                toonBericht(event.message);
                if (event.message.user.id !== eigenGebruikerId) {
                    channel.markRead();
                }
            });

            formulier.addEventListener('submit', async function (e) {
                e.preventDefault();
                const tekst = invoer.value.trim();
                if (!tekst) {
                    return;
                }
                invoer.value = '';
                await channel.sendMessage({ text: tekst });
            });
        })();
    </script>
}
