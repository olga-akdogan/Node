@* Chat screen with speech bubbles (own messages on the right, like
   Tinder/Bumble). Messages don't come from our server: the browser connects
   directly to GetStream Chat here via stream-chat-js and keeps the
   conversation live (new messages appear without a reload). *@
@model Node.Web.Models.Matches.ChatViewModel
@{
    ViewData["Title"] = Model.OtherDisplayName;
}

<div class="mx-auto" style="max-width: 44rem;">
    <div class="d-flex align-items-baseline justify-content-between border-bottom pb-3 mb-3">
        <div>
            <a class="kicker text-decoration-none" asp-action="Index">&larr; @Localizer["Match_Title"]</a>
            <h1 class="mb-0 mt-1">
                @Model.OtherDisplayName
                <button type="button" class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#reportModal">
                    @Localizer["Report_Button"]
                </button>
            </h1>
        </div>
        <div class="text-end">
            <span class="score-number">@Model.CompatibilityScore</span>
            <p class="kicker mb-0">@Localizer["SwipeCard_MatchScore"]</p>
        </div>
    </div>

    @* Report this user: type a reason, submitting goes through ReportController.Create. *@
    <div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Report" asp-action="Create" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="reportModalLabel">@string.Format(Localizer["Report_ModalTitle"], Model.OtherDisplayName)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Nav_Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="reportedUserId" value="@Model.OtherUserId" />
                        <input type="hidden" name="matchId" value="@Model.MatchId" />
                        <label for="reportReason" class="form-label">@Localizer["Moderation_Reason"]</label>
                        <textarea id="reportReason" name="reason" class="form-control" rows="3" maxlength="1000" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Nav_Close"]</button>
                        <button type="submit" class="btn btn-danger">@Localizer["Report_Send"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.CompatibilityExplanation))
    {
        <p class="text-muted small mb-4">@Model.CompatibilityExplanation</p>
    }

    <div id="chat-app"
         data-api-key="@Model.StreamApiKey"
         data-user-token="@Model.StreamUserToken"
         data-current-user-id="@Model.CurrentUserId"
         data-other-user-id="@Model.OtherUserId">
        <div id="messages" class="chat-window mb-3">
            <p class="text-muted small text-center">@Localizer["Chat_LoadingConversation"]</p>
        </div>

        <form id="chat-form" class="d-flex gap-2">
            <input type="text" id="chat-input" class="form-control"
                   placeholder="@Localizer["Chat_WriteMessage"]" maxlength="1000" autocomplete="off" />
            <button type="submit" class="btn btn-primary">@Localizer["Chat_Send"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/stream-chat@8.57.4/dist/browser.full-bundle.min.js"></script>
    <script>
        // Chat logic with GetStream: connect, show existing messages and
        // listen live for new messages from the other user.
        (async function () {
            const app = document.getElementById('chat-app');
            const messagesEl = document.getElementById('messages');
            const form = document.getElementById('chat-form');
            const input = document.getElementById('chat-input');
            const currentUserId = app.dataset.currentUserId;

            const client = StreamChat.getInstance(app.dataset.apiKey);
            await client.connectUser({ id: currentUserId }, app.dataset.userToken);

            // Channel without an explicit id: GetStream derives the id from
            // the member list, so the same two users always find the same
            // conversation.
            const channel = client.channel('messaging', {
                members: [currentUserId, app.dataset.otherUserId],
            });
            await channel.watch();
            await channel.markRead();

            function showMessage(message) {
                const isMine = message.user.id === currentUserId;

                const row = document.createElement('div');
                row.className = 'd-flex ' + (isMine ? 'justify-content-end' : 'justify-content-start');

                const bubble = document.createElement('div');
                bubble.className = 'bubble ' + (isMine ? 'bubble-mine' : 'bubble-other');

                const text = document.createElement('span');
                text.textContent = message.text;

                const time = document.createElement('span');
                time.className = 'bubble-time';
                time.textContent = new Date(message.created_at).toLocaleTimeString('nl-BE', {
                    hour: '2-digit', minute: '2-digit',
                });

                bubble.appendChild(text);
                bubble.appendChild(time);
                row.appendChild(bubble);
                messagesEl.appendChild(row);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            messagesEl.innerHTML = '';
            channel.state.messages.forEach(showMessage);
            messagesEl.scrollTop = messagesEl.scrollHeight;

            channel.on('message.new', function (event) {
                showMessage(event.message);
                if (event.message.user.id !== currentUserId) {
                    channel.markRead();
                }
            });

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const text = input.value.trim();
                if (!text) {
                    return;
                }
                input.value = '';
                await channel.sendMessage({ text });
            });
        })();
    </script>
}
