@* Lege toestand: de horoscoop van deze gebruiker is nog niet berekend. *@
@{
    ViewData["Title"] = Localizer["Nav_MijnHoroscoop"];
}

<div class="mx-auto text-center card p-5" style="max-width: 34rem;">
    <p class="kicker mb-3">@Localizer["NGH_Kicker"]</p>
    <h1 style="font-size: 2rem;">@Localizer["NGH_Titel"]</h1>
    <p class="text-muted mb-4">
        @Localizer["NGH_Tekst"]
    </p>
    <div>
        <a class="btn btn-primary" asp-controller="Manage" asp-action="Index">@Localizer["NGH_Knop"]</a>
    </div>
</div>
