@using Node.Web.Models.Chart
@model HoroscopeViewModel
@{
    ViewData["Title"] = Localizer["Nav_MyHoroscope"];
    ViewData["FullWidth"] = true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="top-bar">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="breadcrumb-text mb-1">
                <a asp-controller="Home" asp-action="Index">&larr; @Localizer["Chart_BackHome"]</a>
            </div>
            <div class="d-flex flex-wrap align-items-baseline gap-3">
                <h1>@Model.DisplayName &mdash; @Localizer["Chart_BirthChartTitle"]</h1>
                <span class="text-muted" style="font-weight: 300; font-size: 0.9rem;">@Model.BirthInfo</span>
            </div>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="Manage" asp-action="Index">@Localizer["Chart_EditBirthData"]</a>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 align-items-start">
        <div class="col-lg-6">
            <div class="card p-4 text-center">
                @* Chart wheel: circles and spokes as in the design; the
                   planet glyphs sit at their real ecliptic longitude
                   (sign index × 30 + degree). 0° Aries is at the top; the
                   rotation onto the ascendant follows in the astrology phase. *@
                <svg viewBox="0 0 480 480" class="img-fluid" style="max-width: 480px;" role="img" aria-label="Natal chart wheel of @Model.DisplayName">
                    <circle cx="240" cy="240" r="228" fill="none" stroke="#16324F" stroke-width="1.4" />
                    <circle cx="240" cy="240" r="180" fill="none" stroke="#8FA5A0" stroke-width="1" />
                    <circle cx="240" cy="240" r="120" fill="none" stroke="#C7CFCD" stroke-width="1" />
                    <circle cx="240" cy="240" r="46" fill="none" stroke="#C7CFCD" stroke-width="1" />
                    @for (var i = 0; i < 12; i++)
                    {
                        var angle = (i * 30 - 90) * Math.PI / 180;
                        var x1 = (240 + 120 * Math.Cos(angle)).ToString("0.0", inv);
                        var y1 = (240 + 120 * Math.Sin(angle)).ToString("0.0", inv);
                        var x2 = (240 + 228 * Math.Cos(angle)).ToString("0.0", inv);
                        var y2 = (240 + 228 * Math.Sin(angle)).ToString("0.0", inv);
                        <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" stroke="#B8C2BF" stroke-width="0.8" />
                    }
                    @for (var i = 0; i < 12; i++)
                    {
                        @* Zodiac signs centered in each segment at r=204.
                           SVG <text> clashes with the Razor tag, hence Html.Raw. *@
                        var angle = (i * 30 + 15 - 90) * Math.PI / 180;
                        var x = (240 + 204 * Math.Cos(angle)).ToString("0.0", inv);
                        var y = (240 + 204 * Math.Sin(angle) + 7).ToString("0.0", inv);
                        var glyph = AstroDisplay.Glyph((Node.Data.Models.Enums.ZodiacSign)i);
                        @Html.Raw($"<text x=\"{x}\" y=\"{y}\" text-anchor=\"middle\" fill=\"#16324F\" font-size=\"21\" font-family=\"Cormorant Garamond, Segoe UI Symbol, serif\">{glyph}</text>")
                    }
                    @foreach (var placement in Model.Placements.Where(p => p.Body != Node.Data.Models.Enums.CelestialBody.Ascendant))
                    {
                        @* Planets at their own longitude, at r=84. *@
                        var angle = (placement.AbsoluteDegrees - 90) * Math.PI / 180;
                        var x = (240 + 84 * Math.Cos(angle)).ToString("0.0", inv);
                        var y = (240 + 84 * Math.Sin(angle) + 6).ToString("0.0", inv);
                        @Html.Raw($"<text x=\"{x}\" y=\"{y}\" text-anchor=\"middle\" fill=\"#0F2E2B\" font-size=\"19\" font-family=\"Cormorant Garamond, Segoe UI Symbol, serif\">{AstroDisplay.Glyph(placement.Body)}</text>")
                    }
                    @Html.Raw("<text x=\"240\" y=\"246\" text-anchor=\"middle\" fill=\"#7A8683\" font-size=\"12\" font-family=\"Jost, sans-serif\" letter-spacing=\"2\">NATAL</text>")
                </svg>
                <div class="text-muted mt-3" style="font-size: 0.85rem; font-weight: 300;">
                    @Localizer["Chart_HousesCaption"]
                </div>
            </div>
        </div>
        <div class="col-lg-6 d-flex flex-column gap-4">
            <div class="d-flex flex-wrap gap-2">
                <span class="chip-navy"><span class="glyph">☉</span> @Localizer["SwipeCard_Sun"] &middot; @AstroDisplay.Name(Model.SunSign, Localizer)</span>
                <span class="chip-navy"><span class="glyph">☽</span> @Localizer["SwipeCard_Moon"] &middot; @AstroDisplay.Name(Model.MoonSign, Localizer)</span>
                <span class="chip-navy"><span class="glyph">↑</span> @Localizer["SwipeCard_Ascendant"] &middot; @AstroDisplay.Name(Model.AscendantSign, Localizer)</span>
            </div>

            <div class="card p-4">
                <p class="kicker mb-3">@Localizer["Chart_Placements"]</p>
                <div class="placements-table">
                    <div class="row-header">
                        <div>@Localizer["Chart_CelestialBody"]</div><div>@Localizer["Chart_Sign"]</div><div>@Localizer["Chart_House"]</div><div class="text-end">@Localizer["Chart_Degree"]</div>
                    </div>
                    @foreach (var placement in Model.Placements)
                    {
                        <div class="placement-row">
                            <div class="d-flex align-items-center gap-2">
                                <span class="glyph-planet">@AstroDisplay.Glyph(placement.Body)</span>
                                @AstroDisplay.Name(placement.Body, Localizer)
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="glyph-sign">@AstroDisplay.Glyph(placement.Sign)</span>
                                @AstroDisplay.Name(placement.Sign, Localizer)
                            </div>
                            <div class="text-muted">@AstroDisplay.HouseOrdinal(placement.House)</div>
                            <div class="text-end text-muted" style="font-weight: 300;">@placement.DegreeText</div>
                        </div>
                    }
                </div>
            </div>

            <div class="card-signature">
                <p class="kicker mb-2">@Localizer["Chart_Signature"]</p>
                <p><em>@Model.Signature</em></p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Interpretation))
            {
                <div class="card p-4">
                    <p class="kicker mb-3">@Localizer["Chart_Interpretation"]</p>
                    <p style="white-space: pre-line;">@Model.Interpretation</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.PartnerPreferenceText))
            {
                <div class="card p-4">
                    <p class="kicker mb-3">@Localizer["Chart_WhatYoureLookingFor"]</p>
                    <p style="white-space: pre-line;">@Model.PartnerPreferenceText</p>
                </div>
            }
        </div>
    </div>
</div>
