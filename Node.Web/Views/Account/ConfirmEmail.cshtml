@{
    ViewData["Title"] = "E-mailbevestiging";
    var gelukt = ViewData["Gelukt"] as bool? ?? false;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center">
        <h1>@ViewData["Title"]</h1>
        @if (gelukt)
        {
            <p>Je e-mailadres is bevestigd. Je kan nu inloggen.</p>
            <a asp-action="Login" class="btn btn-primary">Naar inloggen</a>
        }
        else
        {
            <p class="text-danger">
                De bevestigingslink is ongeldig of verlopen. Registreer opnieuw of
                neem contact op met de beheerder.
            </p>
        }
    </div>
</div>
