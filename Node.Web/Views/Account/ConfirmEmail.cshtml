@{
    ViewData["Title"] = Localizer["ConfirmEmail_Title"];
    var succeeded = ViewData["Gelukt"] as bool? ?? false;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center">
        <h1>@ViewData["Title"]</h1>
        @if (succeeded)
        {
            <p>@Localizer["ConfirmEmail_Success"]</p>
            <a asp-action="Login" class="btn btn-primary">@Localizer["ConfirmEmail_GoToLogin"]</a>
        }
        else
        {
            <p class="text-danger">
                @Localizer["ConfirmEmail_Error"]
            </p>
        }
    </div>
</div>
