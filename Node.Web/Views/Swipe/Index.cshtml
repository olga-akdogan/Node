@* Discover page in the style of Tinder/Bumble: one profile card at a time
   with a pass and like button. The next card and the rating both happen via
   AJAX without a page reload. *@
@model Node.Web.Models.Swiping.SwipeCardViewModel?
@{
    ViewData["Title"] = Localizer["Nav_Discover"];
}

<div class="deck mx-auto">
    <p class="kicker text-center mb-4">@Localizer["Nav_Discover"]</p>

    @* Antiforgery token for the AJAX POST to Rate. *@
    @Html.AntiForgeryToken()

    <div id="card-holder">
        @if (Model is null)
        {
            <partial name="_StackEmpty" />
        }
        else
        {
            <partial name="_SwipeCard" model="Model" />
        }
    </div>

    @* Match notification: hidden until there's a mutual like. *@
    <div id="match-notice" class="match-overlay text-center d-none">
        <p class="kicker mb-3">@Localizer["Swipe_MatchKicker"]</p>
        <h2>@Localizer["Swipe_MatchTitle"]</h2>
        <p class="mb-4">@Localizer["Swipe_MatchText"]</p>
        <a id="match-chat-link" class="btn btn-hero me-3" href="#">@Localizer["Swipe_SendMessage"]</a>
        <a href="#" id="keep-swiping" class="text-link">@Localizer["Swipe_KeepSwiping"]</a>
    </div>
</div>

@section Scripts {
    <script>
        // Swipe logic: rate via AJAX and load the next card as an HTML fragment.
        (function () {
            const token = $('input[name="__RequestVerificationToken"]').val();

            // Fetch the next card (partial view) and show it.
            function loadNext() {
                $('#match-notice').addClass('d-none');
                $('#card-holder').removeClass('d-none')
                    .load('@Url.Action("NextCard", "Swipe")');
            }

            // Send the like or pass for the card that's currently visible.
            function rate(isLike) {
                const card = $('#card-holder [data-user-id]');
                if (card.length === 0) { return; }

                $.post('@Url.Action("Rate", "Swipe")', {
                    targetUserId: card.data('user-id'),
                    isLike: isLike,
                    __RequestVerificationToken: token
                }).done(function (res) {
                    if (res.isMatch) {
                        // Show the match notice instead of the next card right away.
                        $('#match-chat-link').attr('href',
                            '@Url.Action("Chat", "Match")/' + res.matchId);
                        $('#card-holder').addClass('d-none');
                        $('#match-notice').removeClass('d-none');
                    } else {
                        loadNext();
                    }
                });
            }

            // Buttons live in the partial and get swapped out, so bind events on the holder.
            $('#card-holder').on('click', '.action-button-pass', function () { rate(false); });
            $('#card-holder').on('click', '.action-button-like', function () { rate(true); });
            $('#keep-swiping').on('click', function (e) { e.preventDefault(); loadNext(); });
        })();
    </script>
}
