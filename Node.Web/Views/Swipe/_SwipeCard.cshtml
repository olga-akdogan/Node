@* One profile card in the stack. Also loaded standalone via AJAX. *@
@model Node.Web.Models.Swiping.SwipeCardViewModel

<div data-user-id="@Model.UserId">
    <div class="card">
        @* Image area like Tinder: the profile picture if uploaded, otherwise
           a navy block with an initial as fallback. *@
        <div class="card-image">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="@Model.DisplayName" />
            }
            else
            {
                <span class="card-initial">@Model.DisplayName[0]</span>
            }
        </div>
        <div class="card-body p-4">
            <h2 class="mb-0">@Model.DisplayName, @Model.Age</h2>
            <p class="kicker mt-1 mb-3">@Model.BirthPlace</p>

            <div class="d-flex align-items-baseline gap-3 border-top border-bottom py-3 my-3">
                <span class="score-number">@(Model.CompatibilityScore?.ToString() ?? "—")</span>
                <div>
                    <p class="kicker mb-1">@Localizer["SwipeCard_MatchScore"]</p>
                    <p class="text-muted small mb-0">
                        @(Model.CompatibilityExplanation ?? Localizer["SwipeCard_ScorePending"])
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.DateIdea))
            {
                <div class="mb-3">
                    <p class="kicker mb-1">@Localizer["SwipeCard_FirstDate"]</p>
                    <p class="text-muted small mb-0">@Model.DateIdea</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Bio))
            {
                <div class="border-top pt-3">
                    <p class="kicker mb-1">@Localizer["Field_Bio"]</p>
                    <p class="mb-0">@Model.Bio</p>
                </div>
            }
        </div>
    </div>

    @* Pass and like button below the card, like Tinder. *@
    <div class="d-flex justify-content-center gap-4 mt-4">
        <button type="button" class="action-button action-button-pass" title="@Localizer["SwipeCard_Pass"]" aria-label="@Localizer["SwipeCard_Pass"]">&times;</button>
        <button type="button" class="action-button action-button-like" title="@Localizer["SwipeCard_Like"]" aria-label="@Localizer["SwipeCard_Like"]">&hearts;</button>
    </div>
</div>
