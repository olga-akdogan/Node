@* Eén profielkaart in de stapel. Wordt ook los via AJAX geladen. *@
@model Node.Web.Models.Swiping.SwipeCardViewModel

<div data-user-id="@Model.UserId">
    <div class="card">
        @* Beeldvlak zoals bij Tinder: de profielfoto indien geüpload, anders
           een marineblok met initiaal als terugval. *@
        <div class="kaart-blok">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="@Model.DisplayName" />
            }
            else
            {
                <span class="kaart-initiaal">@Model.DisplayName[0]</span>
            }
        </div>
        <div class="card-body p-4">
            <h2 class="mb-0">@Model.DisplayName, @Model.Age</h2>
            <p class="kicker mt-1 mb-3">@Model.BirthPlace</p>

            <div class="d-flex align-items-baseline gap-3 border-top border-bottom py-3 my-3">
                <span class="score-cijfer">@(Model.CompatibilityScore?.ToString() ?? "—")</span>
                <div>
                    <p class="kicker mb-1">@Localizer["SwipeKaart_MatchScore"]</p>
                    <p class="text-muted small mb-0">
                        @(Model.CompatibilityExplanation ?? Localizer["SwipeKaart_ScoreVolgt"])
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Bio))
            {
                <p class="text-muted mb-0">@Model.Bio</p>
            }
        </div>
    </div>

    @* Pas- en like-knop onder de kaart, zoals bij Tinder. *@
    <div class="d-flex justify-content-center gap-4 mt-4">
        <button type="button" class="actieknop actieknop-pass" title="@Localizer["SwipeKaart_Pas"]" aria-label="@Localizer["SwipeKaart_Pas"]">&times;</button>
        <button type="button" class="actieknop actieknop-like" title="@Localizer["SwipeKaart_Like"]" aria-label="@Localizer["SwipeKaart_Like"]">&hearts;</button>
    </div>
</div>
