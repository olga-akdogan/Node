
@using Microsoft.AspNetCore.Identity
@using Node.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Hoe het werkt";
}

<div class="mx-auto" style="max-width: 40rem;">
    <p class="kicker text-center mb-2">Hoe het werkt</p>
    <h1 class="text-center mb-5">De juiste mensen verschijnen<br />op het juiste moment</h1>

    <section class="rubriek mb-5 pb-2">
        <span class="rubriek-nummer">01</span>
        <p class="kicker mb-3">We leren je kennen</p>
        <h2>Meer dan een profiel</h2>
        <p class="text-muted">
            Je reis begint met een gesprek. Je persoonlijke Node-agent leert wie
            je bent, wat je waardevol vindt en naar welke connectie je echt op
            zoek bent.
        </p>
        <p class="text-muted mb-0">
            Samen met je geboortehoroscoop vormt dat een volledig beeld van jou
            &mdash; niet alleen van je voorkeuren.
        </p>
    </section>

    <section class="rubriek mb-5 pb-2">
        <span class="rubriek-nummer">02</span>
        <p class="kicker mb-3">Wij doen het zoekwerk</p>
        <h2>Geen eindeloos scrollen</h2>
        <p class="text-muted">
            Waar andere apps je door honderden profielen laten bladeren, werkt
            Node anders. Onze matching combineert astrologische compatibiliteit
            met het inzicht van je Node-agent, en stelt je zorgvuldig voor aan
            mensen die echt bij je energie en intenties passen.
        </p>
        <p class="pull-quote mb-0">
            Jij zoekt geen matches.<br />Zij vinden jou.
        </p>
    </section>

    <section class="rubriek mb-5 pb-2">
        <span class="rubriek-nummer">03</span>
        <p class="kicker mb-3">Als het goed voelt</p>
        <h2>Introducties met intentie</h2>
        <p class="text-muted">
            Wanneer er een veelbelovende connectie verschijnt, krijgen jullie
            allebei een persoonlijke introductie.
        </p>
        <p class="text-muted">
            Geen algoritmes die op je aandacht jagen.
            Geen race om matches te verzamelen.
        </p>
        <p class="pull-quote mb-0">
            Eén betekenisvol gesprek tegelijk.
        </p>
    </section>
</div>

<section class="hero-node blok-klein text-center">
    <p class="kicker mb-3">Node</p>
    <h2 class="hero-titel-klein">Sommige mensen zijn<br />in je verhaal geschreven</h2>
    @if (!SignInManager.IsSignedIn(User))
    {
        <a class="btn btn-hero mt-4" asp-controller="Account" asp-action="Register">Begin je verhaal</a>
    }
    else
    {
        <a class="btn btn-hero mt-4" asp-controller="Swipe" asp-action="Index">Ontdek profielen</a>
    }
</section>
