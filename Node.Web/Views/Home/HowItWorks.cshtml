
@using Microsoft.AspNetCore.Identity
@using Node.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = Localizer["Nav_HoeHetWerkt"];
}

<div class="mx-auto" style="max-width: 40rem;">
    <p class="kicker text-center mb-2">@Localizer["Nav_HoeHetWerkt"]</p>
    <h1 class="text-center mb-5">@Html.Raw(Localizer["Hiw_Titel"])</h1>

    <section class="rubriek mb-5 pb-2">
        <span class="rubriek-nummer">01</span>
        <p class="kicker mb-3">@Localizer["Hiw_S1Kicker"]</p>
        <h2>@Localizer["Hiw_S1Titel"]</h2>
        <p class="text-muted">
            @Localizer["Hiw_S1Tekst1"]
        </p>
        <p class="text-muted mb-0">
            @Localizer["Hiw_S1Tekst2"]
        </p>
    </section>

    <section class="rubriek mb-5 pb-2">
        <span class="rubriek-nummer">02</span>
        <p class="kicker mb-3">@Localizer["Hiw_S2Kicker"]</p>
        <h2>@Localizer["Hiw_S2Titel"]</h2>
        <p class="text-muted">
            @Localizer["Hiw_S2Tekst"]
        </p>
        <p class="pull-quote mb-0">
            @Html.Raw(Localizer["Hiw_S2Quote"])
        </p>
    </section>

    <section class="rubriek mb-5 pb-2">
        <span class="rubriek-nummer">03</span>
        <p class="kicker mb-3">@Localizer["Hiw_S3Kicker"]</p>
        <h2>@Localizer["Hiw_S3Titel"]</h2>
        <p class="text-muted">
            @Localizer["Hiw_S3Tekst1"]
        </p>
        <p class="text-muted">
            @Localizer["Hiw_S3Tekst2"]
        </p>
        <p class="pull-quote mb-0">
            @Localizer["Hiw_S3Quote"]
        </p>
    </section>
</div>

<section class="hero-node blok-klein text-center">
    <p class="kicker mb-3">Node</p>
    <h2 class="hero-titel-klein">@Html.Raw(Localizer["Hiw_CtaTitel"])</h2>
    @if (!SignInManager.IsSignedIn(User))
    {
        <a class="btn btn-hero mt-4" asp-controller="Account" asp-action="Register">@Localizer["Hiw_CtaBeginVerhaal"]</a>
    }
    else
    {
        <a class="btn btn-hero mt-4" asp-controller="Swipe" asp-action="Index">@Localizer["Nav_Ontdek"]</a>
    }
</section>
