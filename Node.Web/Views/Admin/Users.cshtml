@* Gebruikersbeheer: rollen toekennen/afnemen en
   gebruikers (de)blokkeren. Alleen bereikbaar voor de rol Admin. *@
@model Node.Web.Models.Admin.AdminUsersIndexViewModel
@{
    ViewData["Title"] = Localizer["Nav_Gebruikersbeheer"];
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">@string.Format(Localizer["Admin_AantalGebruikers"], Model.Gebruikers.Count)</p>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="zoek" class="form-label small">@Localizer["Admin_Zoeken"]</label>
        <input type="search" id="zoek" name="zoek" value="@Model.Zoek" class="form-control form-control-sm"
               placeholder="@Localizer["Admin_ZoekenPlaceholder"]" />
    </div>
    <div class="col-auto">
        <label for="rol" class="form-label small">@Localizer["Admin_Rollen"]</label>
        <select id="rol" name="rol" class="form-select form-select-sm">
            <option value="">@Localizer["Admin_AlleRollen"]</option>
            @foreach (var r in Model.AlleRollen)
            {
                <option value="@r" selected="@(r == Model.Rol ? "selected" : null)">@r</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label for="status" class="form-label small">@Localizer["Admin_Status"]</label>
        <select id="status" name="status" class="form-select form-select-sm">
            <option value="">@Localizer["Admin_AlleStatussen"]</option>
            <option value="actief" selected="@("actief" == Model.Status ? "selected" : null)">@Localizer["Admin_Actief"]</option>
            <option value="geblokkeerd" selected="@("geblokkeerd" == Model.Status ? "selected" : null)">@Localizer["Admin_Geblokkeerd"]</option>
        </select>
    </div>
    <div class="col-auto">
        <label for="sortering" class="form-label small">@Localizer["Admin_Sorteren"]</label>
        <select id="sortering" name="sortering" class="form-select form-select-sm">
            <option value="naam_asc" selected="@("naam_asc" == Model.Sortering ? "selected" : null)">@Localizer["Admin_SorteerNaamAZ"]</option>
            <option value="naam_desc" selected="@("naam_desc" == Model.Sortering ? "selected" : null)">@Localizer["Admin_SorteerNaamZA"]</option>
            <option value="email_asc" selected="@("email_asc" == Model.Sortering ? "selected" : null)">@Localizer["Admin_SorteerEmailAZ"]</option>
            <option value="email_desc" selected="@("email_desc" == Model.Sortering ? "selected" : null)">@Localizer["Admin_SorteerEmailZA"]</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">@Localizer["Admin_Filteren"]</button>
        <a asp-action="Users" class="btn btn-sm btn-outline-secondary">@Localizer["Admin_FilterWissen"]</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@Localizer["Admin_Naam"]</th>
                <th>@Localizer["Admin_Email"]</th>
                <th>@Localizer["Admin_Rollen"]</th>
                <th>@Localizer["Admin_Status"]</th>
                <th class="text-end">@Localizer["Admin_Acties"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gebruiker in Model.Gebruikers)
            {
                <tr>
                    <td>@gebruiker.DisplayName</td>
                    <td>
                        @gebruiker.Email
                        @if (!gebruiker.EmailConfirmed)
                        {
                            <span class="badge text-bg-warning" title="@Localizer["Admin_NietBevestigdTitle"]">@Localizer["Admin_NietBevestigdBadge"]</span>
                        }
                    </td>
                    <td>
                        @foreach (var rol in gebruiker.Roles)
                        {
                            <form class="d-inline" asp-action="RemoveRole" method="post"
                                  onsubmit="return confirm('@string.Format(Localizer["Admin_RolAfnemenBevestiging"], rol, gebruiker.DisplayName)');">
                                <input type="hidden" name="id" value="@gebruiker.Id" />
                                <input type="hidden" name="rol" value="@rol" />
                                @* Klikken op het kruisje neemt de rol af. *@
                                <button type="submit" class="btn btn-sm badge text-bg-secondary border-0"
                                        title="@Localizer["Admin_RolAfnemenTitle"]">
                                    @rol &times;
                                </button>
                            </form>
                        }
                        @if (gebruiker.AssignableRoles.Any())
                        {
                            <form class="d-inline-flex gap-1 mt-1" asp-action="AddRole" method="post">
                                <input type="hidden" name="id" value="@gebruiker.Id" />
                                <select name="rol" class="form-select form-select-sm w-auto" aria-label="@Localizer["Admin_RolKiezen"]">
                                    @foreach (var rol in gebruiker.AssignableRoles)
                                    {
                                        <option value="@rol">@rol</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">@Localizer["Admin_Toekennen"]</button>
                            </form>
                        }
                    </td>
                    <td>
                        @if (gebruiker.IsBlocked)
                        {
                            <span class="badge text-bg-danger">@Localizer["Admin_Geblokkeerd"]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">@Localizer["Admin_Actief"]</span>
                        }
                    </td>
                    <td class="text-end">
                        <form class="d-inline" asp-action="ToggleBlock" method="post">
                            <input type="hidden" name="id" value="@gebruiker.Id" />
                            <button type="submit" class="btn btn-sm @(gebruiker.IsBlocked ? "btn-outline-success" : "btn-outline-danger")">
                                @(gebruiker.IsBlocked ? Localizer["Admin_Deblokkeren"] : Localizer["Admin_Blokkeren"])
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
