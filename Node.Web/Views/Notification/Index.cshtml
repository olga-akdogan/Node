@* Notifications page: likes and unread chat messages. Viewing this page
   marks the like-notifications as read (see NotificationController.Index);
   message entries stay until the conversation itself is opened, since their
   read state lives in GetStream, not our database. *@
@using Node.Data.Models.Enums
@model IReadOnlyList<Node.Web.Models.Notifications.NotificationViewModel>
@{
    ViewData["Title"] = Localizer["Notification_Title"];
    var currentType = ViewData["Type"] as string;
    var currentSort = (string)(ViewData["Sort"] ?? "new");
}

<div class="mx-auto" style="max-width: 44rem;">
    <p class="kicker mb-1">@Localizer["Notification_Kicker"]</p>
    <h1 class="mb-4">@Localizer["Notification_Title"]</h1>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label for="type" class="form-label small">@Localizer["Notification_Type"]</label>
            <select id="type" name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(currentType) ? "selected" : null)">@Localizer["Notification_AllTypes"]</option>
                <option value="Like" selected="@(currentType == "Like" ? "selected" : null)">@Localizer["Notification_TypeLike"]</option>
                <option value="Message" selected="@(currentType == "Message" ? "selected" : null)">@Localizer["Notification_TypeMessage"]</option>
            </select>
        </div>
        <div class="col-auto">
            <label for="sort" class="form-label small">@Localizer["Admin_Sort"]</label>
            <select id="sort" name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="new" selected="@(currentSort == "new" ? "selected" : null)">@Localizer["Match_SortRecent"]</option>
                <option value="old" selected="@(currentSort == "old" ? "selected" : null)">@Localizer["Notification_SortOldest"]</option>
            </select>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="card text-center p-5">
            <p class="text-muted mb-0">@Localizer["Notification_Empty"]</p>
        </div>
    }
    else
    {
        <div class="match-list">
            @foreach (var notification in Model)
            {
                var text = notification.Type == NotificationType.Message
                    ? string.Format(Localizer["Notification_Message"].Value, notification.ActorDisplayName)
                    : string.Format(Localizer["Notification_Like"].Value, notification.ActorDisplayName);
                var background = !notification.IsRead ? "background-color: var(--node-sage-tint);" : "";

                @if (notification.Type == NotificationType.Message)
                {
                    // Message notifications link straight to the conversation.
                    <a class="match-row d-flex align-items-center gap-3 text-decoration-none" style="@background"
                       asp-controller="Match" asp-action="Chat" asp-route-id="@notification.MatchId">
                        @if (!string.IsNullOrEmpty(notification.ActorProfilePictureUrl))
                        {
                            <img src="@notification.ActorProfilePictureUrl" alt="@notification.ActorDisplayName" class="avatar-circle" />
                        }
                        else
                        {
                            <span class="avatar-circle">@notification.ActorDisplayName[0]</span>
                        }
                        <span class="flex-grow-1 min-w-0">
                            <span class="d-block">@text</span>
                            <span class="d-block text-muted small">@notification.CreatedAt.ToString("d MMM yyyy · HH:mm", System.Globalization.CultureInfo.CurrentUICulture)</span>
                        </span>
                    </a>
                }
                else
                {
                    // Like notifications have no natural page to link to.
                    <div class="match-row d-flex align-items-center gap-3" style="@background">
                        @if (!string.IsNullOrEmpty(notification.ActorProfilePictureUrl))
                        {
                            <img src="@notification.ActorProfilePictureUrl" alt="@notification.ActorDisplayName" class="avatar-circle" />
                        }
                        else
                        {
                            <span class="avatar-circle">@notification.ActorDisplayName[0]</span>
                        }
                        <span class="flex-grow-1 min-w-0">
                            <span class="d-block">@text</span>
                            <span class="d-block text-muted small">@notification.CreatedAt.ToString("d MMM yyyy · HH:mm", System.Globalization.CultureInfo.CurrentUICulture)</span>
                        </span>
                    </div>
                }
            }
        </div>
    }
</div>
