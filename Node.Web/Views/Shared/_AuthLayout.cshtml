@* Layout voor de auth-schermen (ontwerp 02): volledig scherm, gesplitst in
   een donker paneel links en het formulier rechts — zonder navigatiebalk
   en voettekst. *@
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Node</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-scherm">
        <div class="auth-paneel-donker">
            <a class="logo-woordmerk" asp-controller="Home" asp-action="Index">n<span class="logo-o"></span>de</a>
            <div class="auth-citaat">Begin waar de hemel stond toen jij begon.</div>
            <div class="auth-privacyregel">Je gegevens blijven van jou &mdash; altijd.</div>
        </div>
        <div class="auth-paneel-vorm">
            <main role="main" class="auth-vorm">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
