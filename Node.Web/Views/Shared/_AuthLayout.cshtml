@* Layout for the auth screens (design 02): full screen, split into
   a dark panel on the left and the form on the right — without a nav bar
   or footer. *@
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Node</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-screen">
        <div class="auth-panel-dark">
            <a class="logo-wordmark" asp-controller="Home" asp-action="Index">n<span class="logo-o"></span>de</a>
            <div class="auth-quote">@Localizer["Auth_Quote"]</div>
        </div>
        <div class="auth-panel-form">
            <div class="auth-language-picker-corner">
                <partial name="_LanguagePicker" />
            </div>
            <main role="main" class="auth-form">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (Context.Items["CookieConsentGiven"] is false)
    {
        <partial name="_CookieBanner" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
