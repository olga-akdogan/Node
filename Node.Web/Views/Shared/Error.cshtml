@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">@Localizer["Error_Boodschap"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["Error_RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["Error_DevMode"]</h3>
<p>
    @Localizer["Error_DevModeUitleg1"]
</p>
<p>
    <strong>@Localizer["Error_DevModeUitleg2"]</strong>
</p>
