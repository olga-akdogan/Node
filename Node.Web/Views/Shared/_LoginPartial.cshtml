@* Right side of the nav, per the design: "Log in" as a text link
   plus a sage pill as CTA for visitors; name and log out for members. *@
@using Microsoft.AspNetCore.Identity
@using Node.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-sm-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        <li class="nav-item">
            <a class="nav-link" asp-controller="Manage" asp-action="Index" title="@Localizer["Nav_Settings"]">
                @(user?.DisplayName ?? User.Identity?.Name)
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link">@Localizer["Nav_LogOut"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item me-sm-3">
            <a class="nav-link" asp-controller="Account" asp-action="Login">@Localizer["Nav_LogIn"]</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-accent" asp-controller="Account" asp-action="Register">@Localizer["Nav_CreateYourHoroscope"]</a>
        </li>
    }
</ul>
