
@{
    var darkNav = ViewData["DarkNav"] as bool? == true;
    var fullWidth = ViewData["FullWidth"] as bool? == true;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Node</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Node.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="@(darkNav ? "nav-dark" : "")">
        <nav class="navbar navbar-expand-sm navbar-node">
            <div class="container">
                <a class="navbar-brand logo-wordmark" asp-controller="Home" asp-action="Index">n<span class="logo-o"></span>de</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="@Localizer["Nav_ToggleMenu"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="HowItWorks">@Localizer["Nav_HowItWorks"]</a>
                        </li>
                        @* Discover/Matches/My horoscope are dating features for members;
                           Admin and Moderator are staff accounts, not dating profiles. *@
                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && !User.IsInRole("Moderator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Swipe" asp-action="Index">@Localizer["Nav_Discover"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Match" asp-action="Index">@Localizer["Nav_Matches"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Chart" asp-action="Index">@Localizer["Nav_MyHoroscope"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">@Localizer["Nav_UserManagement"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Moderator") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Moderation" asp-action="Index">@Localizer["Nav_Moderation"]</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <partial name="_LanguagePicker" />
                        <partial name="_NotificationBell" />
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="page-content">

        @if (TempData["Message"] is string message)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Nav_Close"]"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Nav_Close"]"></button>
                </div>
            </div>
        }
        @if (fullWidth)
        {
            @* Full width: the page builds its own sections. *@
            <main role="main">
                @RenderBody()
            </main>
        }
        else
        {
            <div class="container">
                <main role="main" class="py-4">
                    @RenderBody()
                </main>
            </div>
        }
    </div>

    <footer class="footer-node">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3">
            <span class="logo-wordmark">n<span class="logo-o"></span>de</span>
            <span class="d-flex gap-4">
                <a asp-controller="Home" asp-action="HowItWorks">@Localizer["Nav_HowItWorks"]</a>
            </span>
            <span>&copy; 2026 Node</span>
        </div>
    </footer>

    @if (Context.Items["CookieConsentGiven"] is false)
    {
        <partial name="_CookieBanner" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
