
@{
    var donkereNav = ViewData["DonkereNav"] as bool? == true;
    var volleBreedte = ViewData["VolleBreedte"] as bool? == true;
}
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Node</title>
    <script type="importmap"></script>
   
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Node.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="@(donkereNav ? "nav-donker" : "")">
        <nav class="navbar navbar-expand-sm navbar-node">
            <div class="container">
                <a class="navbar-brand logo-woordmerk" asp-controller="Home" asp-action="Index">n<span class="logo-o"></span>de</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menu tonen of verbergen">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="HowItWorks">Hoe het werkt</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Swipe" asp-action="Index">Ontdek</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Match" asp-action="Index">Matches</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Chart" asp-action="Index">Mijn horoscoop</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">Gebruikersbeheer</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="pagina-inhoud">
        
        @if (TempData["Melding"] is string melding)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @melding
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                </div>
            </div>
        }
        @if (TempData["Fout"] is string fout)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @fout
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                </div>
            </div>
        }
        @if (volleBreedte)
        {
            @* Volle breedte: de pagina bouwt zelf haar secties op. *@
            <main role="main">
                @RenderBody()
            </main>
        }
        else
        {
            <div class="container">
                <main role="main" class="py-4">
                    @RenderBody()
                </main>
            </div>
        }
    </div>

    <footer class="footer-node">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3">
            <span class="logo-woordmerk">n<span class="logo-o"></span>de</span>
            <span class="d-flex gap-4">
                <a asp-controller="Home" asp-action="HowItWorks">Hoe het werkt</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
            <span>&copy; 2026 Node</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
