@* Report queue: viewing and handling reported users.
   Reachable for the Moderator and Admin roles. *@
@model IReadOnlyList<Node.Web.Models.Moderation.ReportOverviewViewModel>
@{
    ViewData["Title"] = Localizer["Nav_Moderation"];
    var unresolvedOnly = (bool)(ViewData["UnresolvedOnly"] ?? true);
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">@string.Format(Localizer["Moderation_ReportCount"], Model.Count)</p>

<form method="get" class="mb-3">
    <div class="form-check">
        <input type="checkbox" id="unresolvedOnly" name="unresolvedOnly" value="true" class="form-check-input"
               checked="@(unresolvedOnly ? "checked" : null)" onchange="this.form.submit()" />
        <label for="unresolvedOnly" class="form-check-label">@Localizer["Moderation_UnresolvedOnly"]</label>
    </div>
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">@Localizer["Moderation_NoReports"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>@Localizer["Moderation_Reporter"]</th>
                    <th>@Localizer["Moderation_ReportedUser"]</th>
                    <th>@Localizer["Moderation_Reason"]</th>
                    <th>@Localizer["Moderation_Date"]</th>
                    <th>@Localizer["Admin_Status"]</th>
                    <th>@Localizer["Admin_Block"]</th>
                    <th class="text-end">@Localizer["Admin_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td>@report.ReporterDisplayName</td>
                        <td>@report.ReportedDisplayName</td>
                        <td>@report.Reason</td>
                        <td>@report.CreatedAt.ToString("d")</td>
                        <td>
                            @if (report.IsResolved)
                            {
                                <span class="badge text-bg-success">@Localizer["Moderation_Resolved"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">@Localizer["Moderation_Unresolved"]</span>
                            }
                        </td>
                        <td>
                            @if (report.ReportedUserIsBlocked)
                            {
                                <span class="badge text-bg-danger">@Localizer["Admin_Blocked"]</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!report.IsResolved)
                            {
                                <form asp-action="Resolve" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@report.Id" />
                                    <input type="hidden" name="unresolvedOnly" value="@unresolvedOnly" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@Localizer["Moderation_MarkAsResolved"]</button>
                                </form>
                            }
                            @if (!report.ReportedUserIsBlocked)
                            {
                                <form asp-action="BlockReportedUser" method="post" class="d-inline"
                                      onsubmit="return confirm('@string.Format(Localizer["Moderation_BlockConfirmation"], report.ReportedDisplayName)');">
                                    <input type="hidden" name="id" value="@report.Id" />
                                    <input type="hidden" name="unresolvedOnly" value="@unresolvedOnly" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Moderation_BlockUser"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
