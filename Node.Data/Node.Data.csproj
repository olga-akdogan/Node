<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Alle EF Core- en Identity-pakketten op dezelfde 9.0.x versie houden. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Astrologie-engine: Swiss Ephemeris (planeetposities en huizen). -->
    <PackageReference Include="SwissEphNet" Version="2.8.0.2" />
    <!-- Geboorteplaats (lat/lng) omzetten naar een IANA-tijdzone-id. -->
    <PackageReference Include="GeoTimeZone" Version="6.1.0" />
    <!-- Historisch correcte tijdzone-omrekening (incl. oude DST-regels) via de TZDB. -->
    <PackageReference Include="NodaTime" Version="3.3.3" />
    <!-- Anthropic Claude API: AI-geschreven matchinterpretaties op basis van beide horoscopen. -->
    <PackageReference Include="Anthropic" Version="12.40.0" />
  </ItemGroup>

</Project>
